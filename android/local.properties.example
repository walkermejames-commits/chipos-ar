## Copy this file to local.properties (gitignored) if Android Studio does not
## create it automatically.
##
## Windows example:
## sdk.dir=C:\\Users\\YOUR_NAME\\AppData\\Local\\Android\\Sdk
##
## macOS example:
## sdk.dir=/Users/YOUR_NAME/Library/Android/sdk
sdk.dir=C:\\Users\\YOUR_NAME\\AppData\\Local\\Android\\Sdk
